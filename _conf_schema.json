{
  "nickname": {
    "description": "仪表盘名称",
    "hint": "显示在头像旁边；保留作者默认风格，也可以自由修改。",
    "type": "string",
    "default": "阿柯AKer"
  },
  "avatar_local_path": {
    "description": "本地头像路径",
    "hint": "优先读取，文件不得超过 2 MB；失败时继续尝试远程或平台头像。",
    "type": "string",
    "default": ""
  },
  "avatar_url": {
    "description": "远程头像 URL",
    "hint": "仅接受 HTTP/HTTPS 图片；QQ 平台留空时自动读取机器人头像。",
    "type": "string",
    "default": ""
  },
  "success_text": {
    "description": "无严重异常时的结论",
    "type": "string",
    "default": "阿柯牛逼"
  },
  "fail_text": {
    "description": "存在严重异常时的结论",
    "type": "string",
    "default": "阿柯死了"
  },
  "services": {
    "description": "服务监控目标",
    "hint": "空列表表示不检测服务；GET/HEAD 不会修改目标业务数据。",
    "type": "template_list",
    "templates": {
      "http": {
        "name": "HTTP / HTTPS",
        "display_item": "name",
        "items": {
          "enabled": {"description": "启用", "hint": "关闭后保留配置但不执行检测。", "type": "bool", "default": true},
          "name": {"description": "服务名称", "type": "string", "default": "新 HTTP 服务"},
          "type": {"description": "协议", "type": "string", "options": ["http"], "default": "http"},
          "url": {"description": "完整 URL", "type": "string", "default": "https://example.com/health"},
          "method": {"description": "请求方法", "type": "string", "options": ["GET", "HEAD"], "default": "GET"},
          "headers": {"description": "自定义请求头", "hint": "可填写鉴权头；头内容不会出现在图片中。", "type": "dict", "items": {}, "default": {}}
        }
      },
      "tcp": {
        "name": "TCP 端口",
        "display_item": "name",
        "items": {
          "enabled": {"description": "启用", "hint": "关闭后保留配置但不执行检测。", "type": "bool", "default": true},
          "name": {"description": "服务名称", "type": "string", "default": "新 TCP 服务"},
          "type": {"description": "协议", "type": "string", "options": ["tcp"], "default": "tcp"},
          "host": {"description": "主机名或 IP", "type": "string", "default": "127.0.0.1"},
          "port": {"description": "端口", "type": "int", "default": 6379, "slider": {"min": 1, "max": 65535, "step": 1}}
        }
      }
    },
    "default": []
  },
  "service_timeout": {
    "description": "单个服务超时（秒）",
    "type": "float",
    "default": 5.0,
    "slider": {"min": 0.5, "max": 30, "step": 0.5}
  },
  "service_concurrency": {
    "description": "服务检测并发数",
    "type": "int",
    "default": 8,
    "slider": {"min": 1, "max": 32, "step": 1}
  },
  "resource_interval_minutes": {
    "description": "资源采样间隔（分钟）",
    "hint": "0 关闭后台采样；手动查看仍会记录一个真实样本。",
    "type": "float",
    "default": 10.0,
    "slider": {"min": 0, "max": 1440, "step": 5}
  },
  "resource_history_size": {
    "description": "每项资源保留样本数",
    "type": "int",
    "default": 72,
    "slider": {"min": 2, "max": 288, "step": 1}
  },
  "model_monitor_enabled": {
    "description": "启用 24 小时 API 模型监控",
    "hint": "默认开启。首次运行会立即向每个未排除聊天模型发送一次真实请求，之后每小时一次，即每模型每天最多 24 次；关闭后管理员仍可手动检测。",
    "type": "bool",
    "default": true
  },
  "model_exclude_patterns": {
    "description": "排除模型路由",
    "hint": "每行一个通配符，可匹配配置 ID、模型名或“配置ID::模型名”，例如 expensive-* 或 openai-main::o3。匹配项不会产生探测调用。",
    "type": "list",
    "items": {"type": "string"},
    "default": []
  },
  "model_timeout": {
    "description": "单条模型路由超时（秒）",
    "type": "float",
    "default": 30.0,
    "slider": {"min": 3, "max": 120, "step": 1}
  },
  "model_concurrency": {
    "description": "模型探测并发数",
    "type": "int",
    "default": 6,
    "slider": {"min": 1, "max": 24, "step": 1}
  },
  "model_slow_ms": {
    "description": "模型较慢阈值（毫秒）",
    "type": "int",
    "default": 8000,
    "slider": {"min": 500, "max": 60000, "step": 500}
  },
  "cpu_warning": {"description": "CPU 警告阈值（%）", "hint": "必须低于 CPU 严重阈值。", "type": "float", "default": 75.0, "slider": {"min": 1, "max": 99, "step": 1}},
  "cpu_critical": {"description": "CPU 严重阈值（%）", "hint": "若低于警告阈值，运行时会自动调整为警告值 + 1。", "type": "float", "default": 90.0, "slider": {"min": 2, "max": 100, "step": 1}},
  "memory_warning": {"description": "内存警告阈值（%）", "hint": "必须低于内存严重阈值。", "type": "float", "default": 80.0, "slider": {"min": 1, "max": 99, "step": 1}},
  "memory_critical": {"description": "内存严重阈值（%）", "hint": "若低于警告阈值，运行时会自动调整为警告值 + 1。", "type": "float", "default": 92.0, "slider": {"min": 2, "max": 100, "step": 1}},
  "disk_warning": {"description": "磁盘警告阈值（%）", "hint": "必须低于磁盘严重阈值。", "type": "float", "default": 80.0, "slider": {"min": 1, "max": 99, "step": 1}},
  "disk_critical": {"description": "磁盘严重阈值（%）", "hint": "若低于警告阈值，运行时会自动调整为警告值 + 1。", "type": "float", "default": 92.0, "slider": {"min": 2, "max": 100, "step": 1}},
  "max_service_rows": {"description": "图片最多展开服务数", "hint": "最多 8 行，避免聊天图片过高。", "type": "int", "default": 8, "slider": {"min": 1, "max": 8, "step": 1}},
  "max_model_rows": {"description": "图片最多展开模型数", "hint": "最多 8 个图表，其他模型仍参与总状态判断。最坏布局已按图片高度上限验证。", "type": "int", "default": 8, "slider": {"min": 1, "max": 8, "step": 1}},
  "cache_keep_count": {"description": "临时图片保留数量", "type": "int", "default": 3, "slider": {"min": 1, "max": 20, "step": 1}}
}
