{% from 'macros.html.jinja' import header, overview, services_monitor, model_connectivity %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=900, initial-scale=1">
  <style>{{ css | safe }}</style>
</head>
<body>
  <div class="main-background">
    <div class="main-background-mask">
      <main class="dashboard-shell">
        {{ header(d, avatar_base64, avatar_mime) }}
        {{ overview(d) }}
        {{ services_monitor(d) }}
        {{ model_connectivity(d) }}
      </main>
    </div>
  </div>
</body>
</html>
