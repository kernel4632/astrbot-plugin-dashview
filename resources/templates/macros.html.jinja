{% macro header(d, avatar_base64, avatar_mime) %}
<header class="hero-card">
  <div class="hero-main">
    <div class="hero-avatar-box">
      <img class="hero-avatar" src="data:{{ avatar_mime }};base64,{{ avatar_base64 }}" alt="机器人头像">
    </div>
    <div class="hero-content">
      <h1 class="hero-title">{{ d.nickname }}</h1>
    </div>
  </div>
  <div class="hero-side">
    {% set health = 'good' if d.overall.state == 'healthy' else 'warn' if d.overall.state == 'degraded' else 'danger' if d.overall.state == 'critical' else 'calm' %}
    <div class="hero-health health-{{ health }}">{{ d.overall.label }}</div>
  </div>
</header>
{% endmacro %}


{% macro overview(d) %}
<div class="panel-card overview-panel">
  <div class="section-head">
    <div>
      <div class="section-kicker">Resource Overview</div>
      <h2 class="section-title">资源使用率</h2>
    </div>
  </div>
  <div class="meter-list">
    {% for item in d.resources if item.id != 'swap' %}
    {% set color = 'cyan' if item.id == 'cpu' else 'mint' if item.id == 'memory' else 'purple' %}
    <article class="meter-card meter-{{ color }}">
      <div class="meter-head">
        <span class="meter-dot meter-dot-{{ color }}"></span>
        <span class="meter-name">{{ item.label }}</span>
      </div>
      <div class="meter-value">{{ item.current }}</div>
      <div class="meter-detail">{{ item.detail }}</div>
      <div class="meter-sample">{{ item.sample_count }}/24 小时{% if item.id != 'disk' %} · 平均 {{ item.average }}{% endif %}</div>
      <div class="meter-wave">
        {% if item.id == 'disk' and item.read_points %}
        <svg class="meter-curve" viewBox="0 0 100 40" preserveAspectRatio="none" aria-label="磁盘读写速率趋势">
          <path d="{{ item.read_curve_path }}" class="meter-curve-line meter-curve-purple"></path>
          <path d="{{ item.write_curve_path }}" class="meter-curve-line meter-curve-orange"></path>
        </svg>
        {% elif item.points %}
        <svg class="meter-curve" viewBox="0 0 100 40" preserveAspectRatio="none" aria-label="{{ item.label }}趋势">
          <path d="{{ item.curve_path }}" class="meter-curve-line meter-curve-{{ color }}"></path>
        </svg>
        {% else %}
        <div class="meter-empty">首次采样，等待趋势数据</div>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
</div>
{% endmacro %}


{% macro services_monitor(d) %}
<section class="panel-card services-panel">
    <div class="section-head compact">
      <div>
        <div class="section-kicker">Service Monitor</div>
        <h2 class="section-title">服务状态</h2>
      </div>
    </div>
    {% if d.services.empty_text %}
    <div class="model-empty-card">{{ d.services.empty_text }}</div>
    {% else %}
    <div class="service-list">
      {% for service in d.services.rows %}
      {% set healthy = service.state == 'healthy' %}
      <article class="service-card service-{{ 'good' if healthy else 'danger' }}">
        <div class="service-row">
          <div class="service-main">
            <div class="service-name">{{ service.name }}</div>
            <div class="service-target">{{ service.target }}</div>
          </div>
          <div class="service-meta">
            <div class="service-latency">{{ service.latency }}</div>
            <span class="service-badge badge-{{ 'green' if healthy else 'rose' }}">{{ '正常' if healthy else '受限' if service.state == 'restricted' else '异常' }}</span>
          </div>
        </div>
        <div class="service-foot">
          <div class="service-message">{{ service.reason }}{% if service.status_code %} · {{ service.status_code }}{% endif %}</div>
        </div>
      </article>
      {% endfor %}
    </div>
    {% endif %}
</section>
{% endmacro %}


{% macro model_connectivity(d) %}
<section class="panel-card model-panel">
  <div class="section-head compact">
    <div>
      <div class="section-kicker">Model Connectivity</div>
      <h2 class="section-title">模型连通性</h2>
    </div>
    {% set overall = 'ok' if d.models.state == 'healthy' else 'slow' if d.models.state == 'degraded' else 'error' if d.models.state == 'critical' else 'empty' %}
    <div class="model-overall model-overall-{{ overall }}">
      <span class="model-overall-dot"></span>
      {{ '全部可用' if overall == 'ok' else '存在慢响应' if overall == 'slow' else '存在异常' if overall == 'error' else '状态未知' }}
    </div>
  </div>

  <div class="model-summary-row">
    <div class="model-pill model-pill-ok"><span></span>{{ d.models.available }} 正常</div>
    <div class="model-pill model-pill-slow"><span></span>{{ d.models.slow }} 较慢</div>
    <div class="model-pill model-pill-error"><span></span>{{ d.models.failed }} 错误</div>
    <div class="model-pill model-pill-neutral">{{ d.models.total }} 个模型</div>
    <div class="model-summary-time">{{ d.models.monitor_text }} · 更新于 {{ d.models.age }}</div>
  </div>

  {% if d.models.empty_text %}
  <div class="model-empty-card">{{ d.models.empty_text }}</div>
  {% else %}
  <div class="model-provider-grid">
    {% for model in d.models.rows %}
    {% set status = 'ok' if model.visual_state == 'healthy' else 'slow' if model.visual_state == 'degraded' else 'error' if model.visual_state == 'critical' else 'empty' %}
    <article class="model-provider-card">
      <div class="model-row-list">
        <div class="model-row-card model-row-{{ status }}">
          <div class="model-row-top">
            <div class="model-name-wrap">
              <span class="model-dot model-dot-{{ status }}"></span>
              <span class="model-name-text">{{ model.model_name }}</span>
            </div>
            <span class="model-status-badge model-status-{{ status }}">{{ '正常' if status == 'ok' else '较慢' if status == 'slow' else '异常' if status == 'error' else '未知' }}</span>
          </div>
          <div class="model-curve-box">
            <svg class="model-curve" viewBox="0 0 100 40" preserveAspectRatio="none" aria-label="{{ model.model_name }} 延迟历史">
              {% for segment in model.history_chart.curve_paths %}
              <path d="{{ segment }}" class="model-curve-line model-curve-{{ status }}"></path>
              {% endfor %}
            </svg>
            <div class="model-time-axis">
              {% for label in model.history_chart.time_labels %}<span>{{ label }}</span>{% endfor %}
            </div>
            <div class="model-history" title="最近 24 小时真实检测">
              {% for slot in model.history_chart.slots %}
              {% set slot_status = 'ok' if slot.state == 'healthy' else 'slow' if slot.state == 'degraded' else 'error' if slot.state == 'critical' else 'empty' %}
              <span class="availability-point model-history-bar model-history-{{ slot_status }}"></span>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endmacro %}
